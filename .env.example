# انسخ هذا الملف إلى ".env" ثم ضع القيم الحقيقية من مشروعك في Supabase
# لوحة التحكم: Project Settings > API

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# اختياري:
# VITE_CAMPAIGN_NAME=همة طيبة
# VITE_CAMPAIGN_SUBTITLE=حملة الدعم الجماعي 2026
# VITE_CURRENCY=دولار أمريكي
